const analysisCompareCallouts = [
  { number: 1, title: 'Corpus X', href: '#analysis-compare-1', anchorLeft: 23, anchorTop: 16, boxLeft: 18, boxTop: -8, boxWidth: '8rem' },
  { number: 2, title: 'Corpus Y / rest', href: '#analysis-compare-2', anchorLeft: 72, anchorTop: 16, boxLeft: 74, boxTop: -8, boxWidth: '10rem' },
  { number: 3, title: 'Ranking views', href: '#analysis-compare-3', anchorLeft: 78, anchorTop: 35, boxLeft: 101, boxTop: 31, boxWidth: '9rem' },
