---
import { withBase, withoutBase } from './paths';

const pathname = withoutBase(Astro.url.pathname).replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
};

const items = [
  { route: '/', label: 'HOME' },
  { route: '/documentation', label: 'DOCUMENTATION' },
  { route: '/characters', label: 'INDEX' },
  { route: '/analysis', label: 'ANALYSIS' },
  { route: '/text-comparison', label: 'COMPARE' },
  { route: '/dictionary', label: 'DICTIONARY' },
  { route: '/credits', label: 'CREDITS' },
].map(item => ({ ...item, href: withBase(item.route) }));
---
<header class="chind-global-nav">
  <a class="chind-global-brand" href={withBase('/')} aria-label="CHIND home">
    <span class="chind-global-seal" aria-hidden="true"><i>漢</i><i>拉</i><i>字</i><i>典</i></span>
    <span class="chind-global-brand-copy">
      <strong>Dictionarium Sinico–Latinum</strong>
      <small>CHIND · chindictionary</small>
    </span>
  </a>

  <nav class="chind-global-links" aria-label="Main navigation">
    {items.map(item => (
      <a
        href={item.href}
        class:list={{ active: isActive(item.route) }}
        aria-current={isActive(item.route) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
    <span class="chind-global-rosette" aria-hidden="true">✺</span>
  </nav>
</header>

<style is:global>
  :root {
    --chind-nav-height: 64px;
    --chind-nav-green-1: #032722;
    --chind-nav-green-2: #06362e;
    --chind-nav-gold: #c89a43;
    --chind-nav-gold-soft: #f0cf7d;
    --chind-nav-cream: #f3ead5;
    --chind-nav-muted: #9dbbb2;
    --chind-nav-serif: Georgia, 'Times New Roman', Times, serif;
    --chind-nav-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --chind-nav-cjk: 'Noto Serif CJK SC', 'Noto Serif CJK TC', 'Songti SC', 'STSong', SimSun, serif;
  }

  .chind-global-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    min-height: var(--chind-nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 7px 18px;
    color: var(--chind-nav-cream);
    border-bottom: 1px solid rgba(200, 154, 67, .55);
    background: linear-gradient(90deg, var(--chind-nav-green-1) 0%, var(--chind-nav-green-2) 55%, var(--chind-nav-green-1) 100%);
    box-shadow: 0 4px 15px rgba(0, 0, 0, .16);
    font-family: var(--chind-nav-serif);
  }

  .chind-global-brand {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 13px;
    color: inherit;
    text-decoration: none;
  }

  .chind-global-seal {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    padding: 3px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    place-items: center;
    border: 1px solid var(--chind-nav-gold);
    border-radius: 4px;
    color: var(--chind-nav-gold-soft);
    box-shadow: inset 0 0 0 2px rgba(200, 154, 67, .06);
    font: 16px/1 var(--chind-nav-cjk);
  }
  .chind-global-seal i { font-style: normal; }

  .chind-global-brand-copy { min-width: 0; }
  .chind-global-brand strong {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--chind-nav-gold-soft);
    font-size: clamp(21px, 1.8vw, 30px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.012em;
  }
  .chind-global-brand small {
    display: block;
    margin-top: 4px;
    color: var(--chind-nav-muted);
    font: 7px/1 var(--chind-nav-sans);
    letter-spacing: .19em;
    text-transform: uppercase;
  }

  .chind-global-links {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .chind-global-links a {
    position: relative;
    padding: 7px 13px;
    border-right: 1px solid rgba(200, 154, 67, .42);
    color: var(--chind-nav-cream);
    text-decoration: none;
    font-size: 10px;
    letter-spacing: .07em;
  }
  .chind-global-links a:first-child { border-left: 1px solid rgba(200, 154, 67, .42); }
  .chind-global-links a:hover { color: var(--chind-nav-gold-soft); }
  .chind-global-links a.active { color: var(--chind-nav-gold-soft); }
  .chind-global-links a.active::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 2px;
    background: var(--chind-nav-gold);
  }

  .chind-global-rosette {
    width: 38px;
    height: 38px;
    margin-left: 14px;
    display: grid;
    place-items: center;
    border: 1px solid var(--chind-nav-gold);
    border-radius: 50%;
    color: var(--chind-nav-gold);
    font-size: 22px;
  }

  @media (max-width: 1140px) {
    .chind-global-nav { gap: 12px; padding-inline: 10px; }
    .chind-global-brand small { display: none; }
    .chind-global-brand strong { font-size: 18px; }
    .chind-global-seal { width: 42px; height: 42px; flex-basis: 42px; font-size: 14px; }
    .chind-global-links a { padding-inline: 9px; font-size: 8.5px; }
    .chind-global-rosette { display: none; }
  }

  @media (max-width: 800px) {
    .chind-global-nav { align-items: flex-start; flex-direction: column; }
    .chind-global-links { width: 100%; overflow-x: auto; padding-bottom: 4px; }
  }
</style>
