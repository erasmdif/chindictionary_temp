---
import ChindTopNav from '../components/chind/ChindTopNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Characters — Dictionarium Sinico–Latinum',
  description = 'Explore the dictionary through radicals, stroke counts, readings and documentary attestations.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      html, body { margin: 0; min-height: 100%; }
      body { background: #062722; }
      *, *::before, *::after { box-sizing: border-box; }
      a { color: inherit; }
      button, input, select { font: inherit; }
    </style>
  </head>
  <body>
    <ChindTopNav />
    <slot />
  </body>
</html>
