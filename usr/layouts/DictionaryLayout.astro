---
import SEO from '../../core/components/SEO/SEO.astro';
import { siteMetadata } from '../user.config.mjs';
import ChindTopNav from '../components/chind/ChindTopNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dictionarium Sinico–Latinum',
  description = 'Digital reconstruction of the historical Chinese–Latin dictionary.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} siteMetadata={siteMetadata} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
  </head>
  <body>
    <ChindTopNav />
    <slot />
  </body>
</html>
